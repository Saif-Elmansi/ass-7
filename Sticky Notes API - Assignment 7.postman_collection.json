            {
              "key": "noteId",
              "value": "{{noteId}}"
            }
          ]
        },
        "description": "Fully replaces a note document. All fields must be provided. Owner-only operation. Returns 200 on success, 403 if not owner, 404 if not found, 400 if missing required fields."
      },
      "response": []
