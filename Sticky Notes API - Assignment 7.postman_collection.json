    {
      "name": "Create Note",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"My First Note\", \"content\": \"This is the note content.\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/notes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notes"
          ]
        },
        "description": "Creates a new note for the specified user. Title must not be all-uppercase. Returns 201 on success, 400 if title is all-uppercase or validation fails, 404 if user not found."
      },
      "response": []
    },
    {
      "name": "Update Note (Partial)",
